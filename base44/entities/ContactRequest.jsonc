{
  "name": "ContactRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "tech_stack": {
      "type": "string"
    },
    "worry": {
      "type": "string"
    },
    "package_interest": {
      "type": "string",
      "enum": [
        "Not sure",
        "Persona Test Map",
        "Playwright Suite",
        "Security Bundle",
        "Retainer"
      ],
      "default": "Not sure"
    }
  },
  "required": [
    "name",
    "email"
  ]
}